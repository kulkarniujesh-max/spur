SECRET_KEY=generate-a-long-random-value
# Bootstrap admin. Set these in your hosting provider's environment settings for deployment.
INITIAL_ADMIN_EMAIL=admin@pvppcoe.ac.in
INITIAL_ADMIN_PASSWORD=replace-this-with-a-strong-password
# Optional. Defaults to the local SQLite database. Use PostgreSQL for public deployment.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/spur
# Optional SMTP configuration. Without it, email previews appear in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Spur Events <no-reply@pvppcoe.ac.in>
SMTP_USE_TLS=true
